  "sourcesContent": [
   "// Small \"site\" bundle used to produce real minified stack traces and a source map (fixtures for 0.5 error tracking).\nfunction parsePrice(raw) {\n  if (typeof raw !== 'number') {\n    const err = new TypeError('Price must be a number, got ' + typeof raw);\n    throw err;\n  }\n  return raw;\n}\nfunction computeTotal(cart) {\n  let sum = 0;\n  for (const item of cart.items) sum += parsePrice(item.price) * item.qty;\n  return sum;\n}\nexport function checkout(cart) {\n  return computeTotal(cart);\n}\nexport async function loadProfile(id) {\n  await new Promise(r => setTimeout(r, 5));\n  throw new Error('Profile ' + id + ' not found');\n}\nwindow.shop = {\n  throwUnhandled() { setTimeout(() => { checkout({ items: [{ price: '12', qty: 1 }] }); }, 0); },\n  rejectUnhandled() { loadProfile(42); },\n  manual() { try { checkout({ items: [{ price: null, qty: 2 }] }); } catch (e) { window.posthog.captureException(e, { cart_size: 1 }); } },\n  custom() { window.posthog.captureException(new RangeError('Quantity out of range'), { $exception_fingerprint: 'qty-range' }); },\n};\n"
