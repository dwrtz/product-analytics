 "persons": {
  "source": "nodejs/src/ingestion/common/persons (identify / alias / merge)",
  "scenarios": [
   {
    "name": "identify links the anonymous id",
    "events": [
     {
      "event": "$pageview",
      "distinct_id": "anon-1",
      "properties": {
       "$process_person_profile": false
      }
     },
     {
      "event": "$identify",
      "distinct_id": "user-1",
      "properties": {
       "$anon_distinct_id": "anon-1"
      },
      "$set": {
       "email": "u@example.com"
      }
     }
    ],
    "expect": {
     "persons": [
      {
       "distinct_ids": [
        "anon-1",
        "user-1"
       ],
       "properties": {
        "email": "u@example.com"
       },
       "is_identified": true
      }
     ],
     "events_by_person": {
      "user-1": 2
     }
    }
   },
   {
    "name": "alias joins two ids",
    "events": [
     {
      "event": "$set",
      "distinct_id": "a",
      "properties": {
       "$set": {
        "x": 1
       }
      }
     },
     {
      "event": "$create_alias",
      "distinct_id": "a",
      "properties": {
       "alias": "b"
      }
     }
    ],
    "expect": {
     "persons": [
      {
       "distinct_ids": [
        "a",
        "b"
       ],
       "properties": {
        "x": 1
       },
       "is_identified": true
      }
     ]
    }
   },
   {
    "name": "identify never merges two identified persons",
    "events": [
     {
      "event": "$identify",
      "distinct_id": "u1",
      "properties": {}
     },
     {
      "event": "$identify",
      "distinct_id": "u2",
      "properties": {}
     },
     {
      "event": "$identify",
      "distinct_id": "u2",
      "properties": {
       "$anon_distinct_id": "u1"
      }
     }
    ],
    "expect": {
     "persons": [
      {
       "distinct_ids": [
        "u1"
       ]
      },
      {
       "distinct_ids": [
        "u2"
       ]
      }
     ]
    }
   },
   {
    "name": "$merge_dangerously merges identified persons",
    "events": [
     {
      "event": "$identify",
      "distinct_id": "u1",
      "properties": {},
      "$set": {
       "a": 1,
       "b": 1
      }
     },
     {
      "event": "$identify",
      "distinct_id": "u2",
      "properties": {},
      "$set": {
       "b": 2
      }
     },
     {
      "event": "$merge_dangerously",
      "distinct_id": "u2",
      "properties": {
       "alias": "u1"
      }
     }
    ],
    "expect": {
     "persons": [
      {
       "distinct_ids": [
        "u1",
        "u2"
       ],
       "properties": {
        "a": 1,
        "b": 2
       }
      }
     ]
    }
   },
   {
    "name": "illegal id does not merge",
    "events": [
     {
      "event": "$identify",
      "distinct_id": "user-9",
      "properties": {
       "$anon_distinct_id": "null"
      }
     }
    ],
    "expect": {
     "persons": [
      {
       "distinct_ids": [
        "user-9"
       ]
      }
     ]
    }
   },
   {
    "name": "$set_once keeps the first value, $unset removes",
    "events": [
     {
      "event": "$set",
      "distinct_id": "p",
      "properties": {
       "$set_once": {
        "first": "a"
       },
       "$set": {
        "k": 1
       }
      }
     },
     {
      "event": "$set",
      "distinct_id": "p",
      "properties": {
       "$set_once": {
        "first": "b"
       },
       "$unset": [
        "k"
       ]
      }
     }
    ],
    "expect": {
     "persons": [
      {
       "distinct_ids": [
        "p"
       ],
       "properties": {
        "first": "a"
       }
      }
     ]
    }
   }
  ]
 },
