{
 "about": "Worked examples for protocol.md. Sources are PostHog MIT code paths (rust/capture, rust/common/types, rust/feature-flags, nodejs persons) at posthog commit 0f73d659, or runtime captures of posthog-js 1.450.1 and posthog-node 6.0.3. Times are ms since the Unix epoch unless an ISO string is shown.",
 "timestamps": {
  "source": "rust/common/types/src/timestamp.rs tests",
  "now": "2023-01-01T12:00:00Z",
  "cases": [
   {
    "name": "client clock ahead by 10s",
    "timestamp": "2023-01-01T11:00:00Z",
    "sent_at": "2023-01-01T12:00:10Z",
    "expect": "2023-01-01T10:59:50Z"
   },
   {
    "name": "client clock behind by 10s",
    "timestamp": "2023-01-01T11:00:00Z",
    "sent_at": "2023-01-01T11:59:50Z",
    "expect": "2023-01-01T11:00:10Z"
   },
   {
    "name": "clocks aligned",
    "timestamp": "2023-01-01T11:00:00Z",
    "sent_at": "2023-01-01T12:00:00Z",
    "expect": "2023-01-01T11:00:00Z"
   },
   {
    "name": "no sent_at: timestamp as sent",
    "timestamp": "2023-01-01T11:00:00Z",
    "expect": "2023-01-01T11:00:00Z"
   },
   {
    "name": "ignore_sent_at",
    "timestamp": "2023-01-01T11:00:00Z",
    "sent_at": "2023-01-01T12:00:10Z",
    "ignore_sent_at": true,
    "expect": "2023-01-01T11:00:00Z"
   },
   {
    "name": "nothing: now",
    "expect": "2023-01-01T12:00:00Z"
   },
   {
    "name": "sent_at alone: now",
    "sent_at": "2023-01-01T12:00:10Z",
    "expect": "2023-01-01T12:00:00Z"
   },
   {
    "name": "offset wins",
    "timestamp": "2023-01-01T11:00:00Z",
    "sent_at": "2023-01-01T12:00:10Z",
    "offset": 5000,
    "expect": "2023-01-01T11:59:55Z"
   },
   {
    "name": "unparseable timestamp: now",
    "timestamp": "not a date",
    "expect": "2023-01-01T12:00:00Z"
   },
   {
    "name": "offset out of range is ignored (no timestamp)",
    "offset": -8300000000000000,
    "expect": "2023-01-01T12:00:00Z"
   },
   {
    "name": "offset out of range is ignored (timestamp kept)",
    "timestamp": "2023-01-01T11:00:00Z",
    "offset": 9007199254740991,
    "expect": "2023-01-01T11:00:00Z"
   },
   {
    "name": "more than 23h in the future: now",
    "timestamp": "2023-01-03T12:00:00Z",
    "expect": "2023-01-01T12:00:00Z"
   },
   {
    "name": "22h in the future is kept",
    "timestamp": "2023-01-02T10:00:00Z",
    "expect": "2023-01-02T10:00:00Z"
   },
   {
    "name": "+HH zone gets :00",
    "timestamp": "2023-01-01T14:00:00.000+03",
    "expect": "2023-01-01T11:00:00Z"
   },
   {
    "name": "zone-less time is UTC",
    "timestamp": "2023-01-01T11:00:00",
    "expect": "2023-01-01T11:00:00Z"
   }
  ]
 },
